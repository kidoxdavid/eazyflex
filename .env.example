# Copy to .env.local. Never commit real secrets.
DATABASE_URL=postgres://postgres@localhost:5432/eazyflex
TEST_DATABASE_URL=postgres://postgres@localhost:5432/eazyflex_test
APP_URL=http://localhost:3000
# To open the dev server from a phone on the same Wi-Fi: set APP_URL to http://<laptop-ip>:3000, DEV_ALLOWED_ORIGINS=<laptop-ip>, and run `npx next dev -H 0.0.0.0`
# DEV_ALLOWED_ORIGINS=
# "outbox" stores emails in the email_outbox table (dev/test). Production must configure a real provider driver.
EMAIL_DRIVER=outbox
# Stripe is NOT wired yet (Phase 3). Placeholders documented in PAYMENT_ARCHITECTURE.md
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Email delivery: EMAIL_DRIVER=outbox records only (nothing delivered). Use smtp for real delivery, run `npm run emails:send` on a schedule.
# EMAIL_DRIVER=smtp
# SMTP_URL=smtps://user:password@smtp.example.com:465
# EMAIL_FROM="EazyFlex <no-reply@example.com>"
# Private file storage (local driver; use an S3-compatible driver in production)
# STORAGE_DIR=./.storage
# REQUIRED in production (>= 32 random chars): encrypts TOTP secrets at rest. Rotating it invalidates enrolled authenticators.
APP_SECRET=replace-with-at-least-32-random-characters-0000
# Admin two-factor: "required" (default in production) or "optional" (default elsewhere). Enrolled admins are always challenged.
# MFA_ENFORCEMENT=required
# Operations (see RUNBOOK.md)
# SENTRY_DSN=https://<key>@<host>/<project-id>
# STORAGE_DRIVER=s3        # local | s3
# S3_BUCKET=  S3_REGION=ca-central-1  S3_ENDPOINT=  S3_ACCESS_KEY_ID=  S3_SECRET_ACCESS_KEY=  S3_SSE=AES256
# SCAN_DRIVER=clamav       # none | clamav   (SCAN_REQUIRED defaults to true in production)
# CLAMD_HOST=127.0.0.1  CLAMD_PORT=3310
