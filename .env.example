# Copy to .env.local. Never commit real secrets.
DATABASE_URL=postgres://postgres@localhost:5432/eazyflex
TEST_DATABASE_URL=postgres://postgres@localhost:5432/eazyflex_test
APP_URL=http://localhost:3000
# "outbox" stores emails in the email_outbox table (dev/test). Production must configure a real provider driver.
EMAIL_DRIVER=outbox
# Stripe is NOT wired yet (Phase 3). Placeholders documented in PAYMENT_ARCHITECTURE.md
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Email delivery: EMAIL_DRIVER=outbox records only (nothing delivered). Use smtp for real delivery, run `npm run emails:send` on a schedule.
# EMAIL_DRIVER=smtp
# SMTP_URL=smtps://user:password@smtp.example.com:465
# EMAIL_FROM="Openhour <no-reply@example.com>"
# Private file storage (local driver; use an S3-compatible driver in production)
# STORAGE_DIR=./.storage
